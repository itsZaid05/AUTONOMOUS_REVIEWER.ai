{
  "id": "paperflowcommunicate",
  "versionId": "a15046fb-2095-4f54-99f0-f2125fbd93e5",
  "name": "PaperFlow Agent \u00b7 Detect revised bundle \u2192 match token \u2192 queue revalidation",
  "active": false,
  "nodes": [
    {
      "id": "36de4287-9fc1-43dc-b479-56fa1517dbf2",
      "name": "Scheduled lifecycle check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "c1f8a5ee-c03e-4ee0-9f55-03d3acae6c5f",
      "name": "Execute revisions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PAPERFLOW_API_URL + \"/agent/\" + $env.PAPERFLOW_CONFERENCE_ID + \"/revisions\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        }
      },
      "position": [
        320,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Scheduled lifecycle check": {
      "main": [
        [
          {
            "node": "Execute revisions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
