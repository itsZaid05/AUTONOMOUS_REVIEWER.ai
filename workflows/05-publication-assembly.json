{
  "id": "paperflowpublication",
  "versionId": "486c13a5-d356-4a5c-ab54-32ce5fb05601",
  "name": "PaperFlow Agent \u00b7 All ready \u2192 authorize batch \u2192 assemble \u2192 notify coordinator",
  "active": false,
  "nodes": [
    {
      "id": "d68f04d9-c98e-4e71-a6fa-fa45a7fd2367",
      "name": "Scheduled lifecycle check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "203be893-0288-400e-aefb-30ef50e6756a",
      "name": "Execute publication",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PAPERFLOW_API_URL + \"/agent/\" + $env.PAPERFLOW_CONFERENCE_ID + \"/publication\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        }
      },
      "position": [
        320,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Scheduled lifecycle check": {
      "main": [
        [
          {
            "node": "Execute publication",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
