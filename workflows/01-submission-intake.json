{
  "id": "paperflowintake",
  "versionId": "ff8c8e3b-d1f5-4588-b0f0-57566e57536e",
  "name": "PaperFlow Agent \u00b7 Detect new bundles \u2192 segregate \u2192 queue validation",
  "active": false,
  "nodes": [
    {
      "id": "8052e551-4417-46ad-bd38-f2d48435b7c6",
      "name": "Scheduled lifecycle check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "f8478b1e-89bc-472e-9afe-95d4f23f5dee",
      "name": "Execute intake",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PAPERFLOW_API_URL + \"/agent/\" + $env.PAPERFLOW_CONFERENCE_ID + \"/intake\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        }
      },
      "position": [
        320,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Scheduled lifecycle check": {
      "main": [
        [
          {
            "node": "Execute intake",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
