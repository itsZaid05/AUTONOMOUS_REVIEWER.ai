{
  "id": "paperflowreminders",
  "versionId": "5bf88dc0-c619-41e0-9588-1283ec36096a",
  "name": "PaperFlow Agent \u00b7 Due revisions \u2192 policy-approved reminders \u2192 coordinator escalation",
  "active": false,
  "nodes": [
    {
      "id": "812ccf53-4f41-4d01-91cf-96f3a215b6fd",
      "name": "Scheduled lifecycle check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 5
            }
          ]
        }
      },
      "position": [
        0,
        0
      ]
    },
    {
      "id": "2607763a-d2b3-48fe-a70a-c7740c2a3b40",
      "name": "Execute reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PAPERFLOW_API_URL + \"/agent/\" + $env.PAPERFLOW_CONFERENCE_ID + \"/reminders\" }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        }
      },
      "position": [
        320,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Scheduled lifecycle check": {
      "main": [
        [
          {
            "node": "Execute reminders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
