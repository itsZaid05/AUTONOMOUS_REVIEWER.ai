# Generate strong values. Never commit .env.
DATABASE_URL=postgresql+psycopg://paperflow:CHANGE_ME@postgres:5432/paperflow
POSTGRES_PASSWORD=CHANGE_ME
ADMIN_TOKEN=CHANGE_ME
SIGNING_KEY=CHANGE_ME
REDIS_URL=redis://redis:6379/0
STORAGE=/workspace/AUTONOMOUS_REVIEWER.ai/data
PUBLIC_URL=http://localhost:8000
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=editor@conference.test
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=
CROSSREF_ENABLED=false
# Optional local service; never send unpublished text to a public grammar service by default.
LANGUAGETOOL_URL=

# Single conference batch controlled by n8n schedules.
PAPERFLOW_CONFERENCE_ID=conference

# Optional authenticated production relay (keep credentials in secure settings).
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false

# Real-paper deployment: enter values securely; never commit .env.
# Select a Gemini model available to your key; setup verifies an actual request.
REVIEW_CHUNK_CHARS=10000
REVIEW_RETRIES=3
JOB_TIMEOUT_SECONDS=1200
MAIL_MODE=DEMO
MAILPIT_API_URL=http://mailpit:8025
COMPILE_QUEUE=/compile-queue
COMPILE_TIMEOUT_SECONDS=180
# Existing local n8n owner used only by the verification runner during setup.
N8N_OWNER_EMAIL=
N8N_OWNER_PASSWORD=

# Set true before exposing the dashboard through a public preview or tunnel.
PUBLIC_PREVIEW=false

N8N_URL=http://n8n:5678
